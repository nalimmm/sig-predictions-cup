# Copy to /etc/book-recorder.env (chmod 600, owner root) and fill in. Never commit the real file.
# Access key of an UpCloud Object Storage user limited to the bucket below.
BOOK_S3_ENDPOINT=https://xxxxx.upcloudobjects.com
BOOK_S3_BUCKET=
BOOK_S3_KEY_ID=
BOOK_S3_SECRET=
# BOOK_S3_REGION=europe-1
# BOOK_S3_PREFIX=polymarket/
