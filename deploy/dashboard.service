[Unit]
Description=Predictions Cup live dashboard
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/predictions-cup
EnvironmentFile=/etc/predictions-cup.env
ExecStart=/usr/bin/python3 /opt/predictions-cup/src/dashboard.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
