[Unit]
Description=Polymarket order book recorder (websocket market channel to daily gzip files)
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/sig-predictions-cup
ExecStart=/usr/bin/python3 -m book_recorder record --out /var/lib/book-recorder --markets 100 --max-gb 12
# /var/lib/book-recorder, created and owned by the service user
StateDirectory=book-recorder
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# One core and 2 GB shared with the trading services: the recorder yields to them.
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=400M

[Install]
WantedBy=multi-user.target
