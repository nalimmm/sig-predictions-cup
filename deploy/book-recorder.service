[Unit]
Description=Polymarket order book recorder (websocket market channel to daily gzip files)
After=network-online.target
Wants=network-online.target

[Service]
User=bot
# The code tree the Smart deployment refreshes (git archive into /opt/smart-mm).
WorkingDirectory=/opt/smart-mm
# The paper simulator's markets (SMART_MM_SLUGS) are pinned so they are always recorded; --wide adds
# quieter markets with a spread of 2 ticks or more, the kind the market making scan can select.
EnvironmentFile=-/etc/smart-mm.env
ExecStart=/usr/bin/python3 -m book_recorder record --out /var/lib/book-recorder --markets 100 --wide 40 --pin "${SMART_MM_SLUGS}" --max-gb 12
# /var/lib/book-recorder, created and owned by the service user
StateDirectory=book-recorder
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# One core and 2 GB shared with the trading services: the recorder yields to them.
Nice=10
CPUWeight=20
IOWeight=20
MemoryMax=500M

[Install]
WantedBy=multi-user.target
